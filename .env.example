# Public — safe to ship in client bundle (anon key only)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Edge Function secrets — set via `supabase secrets set`, never in client
# SUPABASE_SERVICE_ROLE_KEY=...
# AGENTMAIL_API_KEY=...
# AGENTMAIL_WEBHOOK_SECRET=...
# ANTHROPIC_API_KEY=...
# EXPO_ACCESS_TOKEN=...
